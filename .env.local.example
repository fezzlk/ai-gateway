# Copy to .env.local for local development (never commit .env.local).
# In Cloud Run, these are set via cloudbuild.yaml's --set-env-vars /
# --set-secrets instead — see cloudbuild.yaml.

AI_GATEWAY_SHARED_TOKEN=change-me-to-a-long-random-value
MAC_SSH_HOST=your-mac.your-tailnet.ts.net
MAC_SSH_USER=your-mac-username
MAC_SSH_KNOWN_HOST_LINE=
MAC_SSH_KEY_PATH=./.dev-keys/mac_ssh_key

CLAUDE_ALLOWED_TOOLS=Bash,Read,Edit
PORT=8080
